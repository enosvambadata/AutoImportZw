# ---- Shared ----
COMPOSE_PROJECT_NAME=autobid

# ---- Database ----
POSTGRES_USER=autobid
POSTGRES_PASSWORD=autobid_dev_password
POSTGRES_DB=autobid
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Async URL used by the API (SQLAlchemy 2 async). For local (non-docker) use localhost.
DATABASE_URL=postgresql+asyncpg://autobid:autobid_dev_password@db:5432/autobid
# Sync URL used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://autobid:autobid_dev_password@db:5432/autobid

# ---- API ----
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# CHANGE THESE IN PRODUCTION. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-in-production-please-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
AUTH_RATE_LIMIT_PER_MINUTE=10
VAT_RATE=0.20

# ---- AI advisor (Claude vision, optional) ----
# Photo damage scanning uses Claude as an intelligent advisor. If ANTHROPIC_API_KEY is empty,
# a clearly-labelled mock adapter is used instead so the feature works without credentials.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- eBay Browse API (parts sourcing; free developer keys) ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_GB

# ---- UK government vehicle-data APIs (free, official; used for registration look-up) ----
# DVLA Vehicle Enquiry Service (make, year, fuel, colour, engine, tax/MOT status)
DVLA_VES_API_KEY=
# DVSA MOT History (make, model, colour, fuel + MOT history) — OAuth2 client credentials + API key
DVSA_MOT_API_KEY=
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_TOKEN_URL=
# DVSA_MOT_SCOPE and the endpoint URLs have sensible defaults; override only if DVSA changes them.

# ---- Data connectors (optional; each needs an official API account/agreement) ----
# Copart member/partner catalogue API
COPART_API_URL=
COPART_API_KEY=
# SYNETIQ salvage-auction data feed
SYNETIQ_API_URL=
SYNETIQ_API_KEY=
# Auto Trader Connect (live retail pricing / comparables) — key + secret mint a token
AUTOTRADER_API_URL=
AUTOTRADER_API_KEY=
AUTOTRADER_API_SECRET=

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-side base URL (used by Next.js server components / route handlers inside docker)
API_INTERNAL_BASE_URL=http://api:8000/api/v1
