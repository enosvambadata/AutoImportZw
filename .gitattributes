# Normalise line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows launchers must stay CRLF to be double-clickable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Binaries — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
